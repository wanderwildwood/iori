<?xml version="1.0" encoding="utf-8"?>
<!-- // iori: nothing of Home goes to the cloud backup or to a phone-to-phone transfer (Android 12
     and later), for the reasons in backup_rules.xml. "Back up and restore" in Home's settings
     is the way to move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
