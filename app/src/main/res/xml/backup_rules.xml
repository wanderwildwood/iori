<?xml version="1.0" encoding="utf-8"?>
<!-- // iori: nothing of Home goes into Android's own backup (Android 11 and older). Its files hold
     kept notifications (sender and message text) and crash reports, and its settings hold the
     app lists and search history; the README and the privacy page say these stay on the phone.
     "Back up and restore" in Home's settings is the way to take a layout to another phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
